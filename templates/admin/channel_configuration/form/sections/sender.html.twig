{% set form = hookable_metadata.context.form %}

<div class="col-12 col-lg-6">
    <div class="card h-100">
        <div class="card-header">
            <div class="card-title">{{ 'odiseo_brevo.ui.default_sender'|trans }}</div>
        </div>
        <div class="card-body">
            {{ form_row(form.senderName, sylius_test_form_attribute('sender-name')) }}
            {{ form_row(form.senderEmail, sylius_test_form_attribute('sender-email')) }}
        </div>
    </div>
</div>
