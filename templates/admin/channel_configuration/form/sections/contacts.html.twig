{% set form = hookable_metadata.context.form %}

<div class="col-12">
    <div class="card h-100">
        <div class="card-header">
            <div class="card-title">{{ 'odiseo_brevo.ui.contacts'|trans }}</div>
        </div>
        <div class="card-body">
            {{ form_row(form.customersListId, sylius_test_form_attribute('customers-list')) }}
            {{ form_row(form.syncingGuestContacts, sylius_test_form_attribute('syncing-guest-contacts')) }}
            {{ form_row(form.deletingContactsOfRemovedCustomers, sylius_test_form_attribute('deleting-contacts-of-removed-customers')) }}
        </div>
    </div>
</div>
