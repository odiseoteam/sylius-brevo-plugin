DATABASE_URL=mysql://root:root@127.0.0.1/odiseo_sylius_brevo_plugin_%kernel.environment%

BEHAT_BASE_URL="http://nginx/"

DEFAULT_URI="http://localhost"

SYLIUS_TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="@OdiseoSyliusBrevoPlugin/tests/TestApplication/config/config.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="@OdiseoSyliusBrevoPlugin/tests/TestApplication/config/routes.yaml"

# Test-only key for Sylius encryption (the Brevo API key is encrypted with it).
SYLIUS_PAYMENT_ENCRYPTION_KEY_PATH="%kernel.project_dir%/../../../tests/TestApplication/config/encryption/test.key"
