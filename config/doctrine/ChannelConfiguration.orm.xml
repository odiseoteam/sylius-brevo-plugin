<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Odiseo\SyliusBrevoPlugin\Entity\ChannelConfiguration" table="odiseo_brevo_channel_configuration">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO"/>
        </id>

        <one-to-one field="channel" target-entity="Sylius\Component\Channel\Model\ChannelInterface">
            <join-column name="channel_id" referenced-column-name="id" nullable="false" unique="true" on-delete="CASCADE"/>
        </one-to-one>

        <field name="enabled" type="boolean"/>
        <!-- Encrypted: far longer than the key itself. -->
        <field name="apiKey" column="api_key" type="text" nullable="true"/>
        <field name="senderName" column="sender_name" type="string" nullable="true"/>
        <field name="senderEmail" column="sender_email" type="string" nullable="true"/>
        <field name="modules" type="json"/>
        <field name="syncingGuestContacts" column="syncing_guest_contacts" type="boolean"/>
        <field name="deletingContactsOfRemovedCustomers" column="deleting_contacts_of_removed_customers" type="boolean"/>
        <field name="customersListId" column="customers_list_id" type="integer" nullable="true"/>
        <field name="newsletterListId" column="newsletter_list_id" type="integer" nullable="true"/>
        <field name="doubleOptInTemplateId" column="double_opt_in_template_id" type="integer" nullable="true"/>
        <field name="trackerClientKey" column="tracker_client_key" type="string" length="64" nullable="true"/>

        <field name="createdAt" type="datetime" column="created_at">
            <gedmo:timestampable on="create"/>
        </field>
        <field name="updatedAt" type="datetime" column="updated_at" nullable="true">
            <gedmo:timestampable on="update"/>
        </field>
    </mapped-superclass>
</doctrine-mapping>
